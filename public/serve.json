{
  "rewrites": [
    { "source": "/confirm/**", "destination": "/index.html" },
    { "source": "/:lang(ru|ky|tr|ko)/confirm/**", "destination": "/index.html" },
    { "source": "/:lang(ru|ky|tr|ko)/:slug([A-Za-z0-9-]+)", "destination": "/index.html" },
    { "source": "/:lang(ru|ky|tr|ko)", "destination": "/index.html" },
    { "source": "/:slug([A-Za-z0-9-]+)", "destination": "/index.html" }
  ]
}
